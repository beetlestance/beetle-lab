BEETLE_INSTANCE=local
BEETLE_ROOT=/home/you/beetle-lab-data
BEETLE_REQUEST_FILE=/home/you/beetle-lab-setup/request.json
BEETLE_UID=1000
BEETLE_GID=1000
BEETLE_DOCKER_GID=0
BEETLE_DOCKER_SOCKET=/var/run/docker.sock
BEETLE_PORT=4310
BEETLE_FRONTEND_IMAGE=beetle-lab-rewrite-frontend:local
BEETLE_BACKEND_IMAGE=beetle-lab-rewrite-backend:local
BEETLE_AGENT_IMAGE=beetle-lab-rewrite-agent:local
BEETLE_INSTALLER_IMAGE=beetle-lab-rewrite-installer:local
BEETLE_ENGINE_IMAGE=beetle-lab-rewrite-k6:local
