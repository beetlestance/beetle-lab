{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beetle-lab.dev/contracts/api/v2/run-events",
  "title": "ApiRunEvents",
  "$defs": {
    "RunEventPage": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Uuid"
        },
        "scope": {
          "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/WorkspaceScope"
        },
        "activeAttemptId": {
          "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Uuid"
        },
        "generation": {
          "const": 1
        },
        "afterSeq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "durableThrough": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "coverage": {
          "enum": [
            "pending",
            "contiguous",
            "partial"
          ]
        },
        "blockedReason": {
          "anyOf": [
            {
              "enum": [
                "cursor_expired",
                "quota_exhausted",
                "missing_receipt",
                "replay_conflict"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "retainedStartSeq": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "https://beetle-lab.dev/contracts/runner/v1/agent-event"
          }
        },
        "resumeCursor": {
          "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/OpaqueCursor"
        },
        "nextCursor": {
          "anyOf": [
            {
              "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/OpaqueCursor"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "scope",
        "activeAttemptId",
        "generation",
        "afterSeq",
        "durableThrough",
        "coverage",
        "blockedReason",
        "retainedStartSeq",
        "items",
        "resumeCursor",
        "nextCursor"
      ],
      "additionalProperties": false
    }
  }
}
