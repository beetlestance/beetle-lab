{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beetle-lab.dev/contracts/api/v2/retention-status",
  "title": "ApiRetentionStatus",
  "$defs": {
    "RetentionStatusItem": {
      "type": "object",
      "properties": {
        "runId": {"$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Uuid"},
        "runVersion": {"$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Version"},
        "deletionId": {"$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Uuid"},
        "phase": {"enum": ["preview", "admitted", "backend_files", "agent_cleanup", "settling", "settled", "blocked"]},
        "fileCount": {
          "anyOf": [
            {"$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Count"},
            {"type": "null"}
          ]
        },
        "preparedCount": {
          "anyOf": [
            {"$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Count"},
            {"type": "null"}
          ]
        },
        "absentCount": {
          "anyOf": [
            {"$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Count"},
            {"type": "null"}
          ]
        },
        "error": {"enum": [null, "unavailable", "conflict", "capacity_unavailable", "cleanup_failed"]},
        "refundedLogicalBytes": {"$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Count"}
      },
      "required": [
        "runId",
        "runVersion",
        "deletionId",
        "phase",
        "fileCount",
        "preparedCount",
        "absentCount",
        "error",
        "refundedLogicalBytes"
      ],
      "additionalProperties": false
    },
    "RetentionBatchStatus": {
      "type": "object",
      "properties": {
        "id": {"$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Uuid"},
        "scope": {"$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/WorkspaceScope"},
        "kind": {"enum": ["retention", "manual"]},
        "state": {"enum": ["preview", "applied", "completed"]},
        "capturedAt": {"$ref": "https://beetle-lab.dev/contracts/api/v2/run#/$defs/RunTimestamp"},
        "expiresAt": {"$ref": "https://beetle-lab.dev/contracts/api/v2/run#/$defs/RunTimestamp"},
        "completedAt": {
          "anyOf": [
            {"$ref": "https://beetle-lab.dev/contracts/api/v2/run#/$defs/RunTimestamp"},
            {"type": "null"}
          ]
        },
        "estimatedLogicalBytes": {"$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Count"},
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {"$ref": "https://beetle-lab.dev/contracts/api/v2/retention-status#/$defs/RetentionStatusItem"}
        },
        "completedCount": {"type": "integer", "minimum": 0, "maximum": 100},
        "refundedLogicalBytes": {"$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Count"},
        "driverState": {"$ref": "https://beetle-lab.dev/contracts/api/v2/retention-status#/$defs/RetentionDriverState"}
      },
      "required": [
        "id",
        "scope",
        "kind",
        "state",
        "capturedAt",
        "expiresAt",
        "completedAt",
        "estimatedLogicalBytes",
        "items",
        "completedCount",
        "refundedLogicalBytes",
        "driverState"
      ],
      "additionalProperties": false
    },
    "RetentionBatchSummary": {
      "type": "object",
      "properties": {
        "id": {"$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Uuid"},
        "scope": {"$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/WorkspaceScope"},
        "kind": {"enum": ["retention", "manual"]},
        "state": {"enum": ["preview", "applied", "completed"]},
        "capturedAt": {"$ref": "https://beetle-lab.dev/contracts/api/v2/run#/$defs/RunTimestamp"},
        "expiresAt": {"$ref": "https://beetle-lab.dev/contracts/api/v2/run#/$defs/RunTimestamp"},
        "completedAt": {
          "anyOf": [
            {"$ref": "https://beetle-lab.dev/contracts/api/v2/run#/$defs/RunTimestamp"},
            {"type": "null"}
          ]
        },
        "candidateCount": {"type": "integer", "minimum": 0, "maximum": 100}
      },
      "required": [
        "id",
        "scope",
        "kind",
        "state",
        "capturedAt",
        "expiresAt",
        "completedAt",
        "candidateCount"
      ],
      "additionalProperties": false
    },
    "RetentionBatchList": {
      "type": "object",
      "properties": {
        "scope": {"$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/WorkspaceScope"},
        "items": {
          "type": "array",
          "maxItems": 8,
          "items": {"$ref": "https://beetle-lab.dev/contracts/api/v2/retention-status#/$defs/RetentionBatchSummary"}
        }
      },
      "required": [
        "scope",
        "items"
      ],
      "additionalProperties": false
    },
    "RetentionDiscardReceipt": {
      "type": "object",
      "properties": {
        "id": {"$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Uuid"},
        "scope": {"$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/WorkspaceScope"},
        "refundedLogicalBytes": {"const": 131072}
      },
      "required": [
        "id",
        "scope",
        "refundedLogicalBytes"
      ],
      "additionalProperties": false
    },
    "RetentionDriverState": {"enum": ["running", "stopped", "disabled", "unknown"]}
  }
}
