{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beetle-lab.dev/contracts/api/v2/input-columns",
  "title": "ApiInputColumns",
  "$defs": {
    "InputColumnsQuery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "csv",
            "json"
          ]
        }
      }
    },
    "InputColumns": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "inputId",
        "sha256",
        "bytes",
        "kind",
        "columns"
      ],
      "properties": {
        "scope": {
          "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/WorkspaceScope"
        },
        "inputId": {
          "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Uuid"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8388608
        },
        "kind": {
          "enum": [
            "csv",
            "json"
          ]
        },
        "columns": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,63}$",
                "not": {
                  "enum": [
                    "__proto__",
                    "prototype",
                    "constructor"
                  ]
                }
              }
            }
          ]
        }
      }
    }
  }
}
