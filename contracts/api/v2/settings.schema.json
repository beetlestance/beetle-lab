{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beetle-lab.dev/contracts/api/v2/settings",
  "title": "ApiSettings",
  "$defs": {
    "SettingsIdentity": {
      "type": "object",
      "properties": {
        "id": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Uuid" },
        "version": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Version" },
        "schemaVersion": { "const": 2 },
        "effective": { "$ref": "https://beetle-lab.dev/contracts/api/v2/settings-values#/$defs/EffectiveSettings" }
      },
      "required": ["id", "version", "schemaVersion", "effective"]
    },
    "InstallationSettings": {
      "type": "object", "allOf": [{ "$ref": "https://beetle-lab.dev/contracts/api/v2/settings#/$defs/SettingsIdentity" }],
      "properties": {
        "scope": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/InstallationScope" },
        "values": { "$ref": "https://beetle-lab.dev/contracts/api/v2/settings-values#/$defs/InstallationValues" }
      },
      "required": ["scope", "values"], "unevaluatedProperties": false
    },
    "OrganizationSettings": {
      "type": "object", "allOf": [{ "$ref": "https://beetle-lab.dev/contracts/api/v2/settings#/$defs/SettingsIdentity" }],
      "properties": {
        "scope": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/OrganizationScope" },
        "overrides": { "$ref": "https://beetle-lab.dev/contracts/api/v2/settings-overrides#/$defs/ScopedOverrides" }
      },
      "required": ["scope", "overrides"], "unevaluatedProperties": false
    },
    "WorkspaceSettings": {
      "type": "object", "allOf": [{ "$ref": "https://beetle-lab.dev/contracts/api/v2/settings#/$defs/SettingsIdentity" }],
      "properties": {
        "scope": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/WorkspaceScope" },
        "overrides": { "$ref": "https://beetle-lab.dev/contracts/api/v2/settings-overrides#/$defs/ScopedOverrides" }
      },
      "required": ["scope", "overrides"], "unevaluatedProperties": false
    },
    "PatchInstallationSettingsRequest": {
      "type": "object", "allOf": [{ "$ref": "https://beetle-lab.dev/contracts/api/v2/namespace-requests#/$defs/VersionedIntent" }],
      "properties": {
        "scope": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/InstallationScope" },
        "schemaVersion": { "const": 2 },
        "patch": { "$ref": "https://beetle-lab.dev/contracts/api/v2/settings-overrides#/$defs/InstallationPatch" }
      },
      "required": ["scope", "schemaVersion", "patch"], "unevaluatedProperties": false
    },
    "PatchOrganizationSettingsRequest": {
      "type": "object", "allOf": [{ "$ref": "https://beetle-lab.dev/contracts/api/v2/namespace-requests#/$defs/VersionedIntent" }],
      "properties": {
        "scope": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/OrganizationScope" },
        "schemaVersion": { "const": 2 },
        "patch": { "$ref": "https://beetle-lab.dev/contracts/api/v2/settings-overrides#/$defs/ScopedOverridePatch" }
      },
      "required": ["scope", "schemaVersion", "patch"], "unevaluatedProperties": false
    },
    "PatchWorkspaceSettingsRequest": {
      "type": "object", "allOf": [{ "$ref": "https://beetle-lab.dev/contracts/api/v2/namespace-requests#/$defs/VersionedIntent" }],
      "properties": {
        "scope": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/WorkspaceScope" },
        "schemaVersion": { "const": 2 },
        "patch": { "$ref": "https://beetle-lab.dev/contracts/api/v2/settings-overrides#/$defs/ScopedOverridePatch" }
      },
      "required": ["scope", "schemaVersion", "patch"], "unevaluatedProperties": false
    }
  }
}
