{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beetle-lab.dev/contracts/api/v2/input",
  "title": "ApiInput",
  "$defs": {
    "InputRecord": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Uuid"
        },
        "scope": {
          "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/WorkspaceScope"
        },
        "name": {
          "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Name"
        },
        "folderId": {
          "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Uuid"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8388608
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8388608
        },
        "version": {
          "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Version"
        },
        "state": {
          "enum": [
            "staging",
            "publishing",
            "published",
            "deleting",
            "deleted",
            "failed"
          ]
        },
        "reason": {
          "enum": [
            null,
            "custody_missing",
            "integrity",
            "io",
            "unverified_legacy"
          ]
        }
      },
      "required": [
        "id",
        "scope",
        "name",
        "folderId",
        "sha256",
        "bytes",
        "offset",
        "version",
        "state",
        "reason"
      ],
      "additionalProperties": false
    },
    "InputReceipt": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Uuid"
        },
        "scope": {
          "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/WorkspaceScope"
        },
        "requestId": {
          "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Uuid"
        },
        "operation": {
          "enum": [
            "seal",
            "delete"
          ]
        },
        "acceptedVersion": {
          "type": "integer",
          "minimum": 2,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "scope",
        "requestId",
        "operation",
        "acceptedVersion"
      ],
      "additionalProperties": false
    },
    "InputPage": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/WorkspaceScope"
        },
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "https://beetle-lab.dev/contracts/api/v2/input#/$defs/InputRecord"
          }
        },
        "nextCursor": {
          "anyOf": [
            {
              "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/OpaqueCursor"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "scope",
        "items",
        "nextCursor"
      ],
      "additionalProperties": false
    }
  }
}
