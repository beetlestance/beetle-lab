{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beetle-lab.dev/contracts/api/v2/run",
  "title": "ApiRun",
  "$defs": {
    "RunExecutionPolicy": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "parallel",
            "isolated"
          ]
        },
        "preferIdle": {
          "type": "boolean"
        }
      },
      "required": [
        "mode",
        "preferIdle"
      ],
      "additionalProperties": false
    },
    "RunEngine": {
      "type": "object",
      "properties": {
        "id": {
          "const": "k6"
        },
        "profileId": {
          "$ref": "https://beetle-lab.dev/contracts/api/v2/settings-values#/$defs/EngineProfile"
        },
        "imageDigest": {
          "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/imageDigest"
        },
        "configVersion": {
          "const": 1
        }
      },
      "required": [
        "id",
        "profileId",
        "imageDigest",
        "configVersion"
      ],
      "additionalProperties": false
    },
    "RunSettingsVersions": {
      "type": "object",
      "properties": {
        "installation": {
          "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Version"
        },
        "organization": {
          "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Version"
        },
        "workspace": {
          "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Version"
        }
      },
      "required": [
        "installation",
        "organization",
        "workspace"
      ],
      "additionalProperties": false
    },
    "Run": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Uuid"
        },
        "scope": {
          "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/WorkspaceScope"
        },
        "version": {
          "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Version"
        },
        "suiteId": {
          "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Uuid"
        },
        "revisionId": {
          "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Uuid"
        },
        "revisionDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "requestedAt": {
          "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/timestamp"
        },
        "state": {
          "enum": [
            "queued",
            "dispatching",
            "active",
            "finalizing",
            "finished",
            "cancelled",
            "errored"
          ]
        },
        "outcome": {
          "enum": [
            "pending",
            "passed",
            "failed",
            "inconclusive"
          ]
        },
        "validationStatus": {
          "enum": [
            "pending",
            "passed",
            "failed"
          ]
        },
        "activeAttemptId": {
          "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Uuid"
        },
        "cancellationRequested": {
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/reason"
            },
            {
              "type": "null"
            }
          ]
        },
        "engine": {
          "$ref": "https://beetle-lab.dev/contracts/api/v2/run#/$defs/RunEngine"
        },
        "budget": {
          "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Budget"
        },
        "executionPolicy": {
          "$ref": "https://beetle-lab.dev/contracts/api/v2/run#/$defs/RunExecutionPolicy"
        },
        "settingsVersions": {
          "$ref": "https://beetle-lab.dev/contracts/api/v2/run#/$defs/RunSettingsVersions"
        }
      },
      "required": [
        "id",
        "scope",
        "version",
        "suiteId",
        "revisionId",
        "revisionDigest",
        "requestedAt",
        "state",
        "outcome",
        "validationStatus",
        "activeAttemptId",
        "cancellationRequested",
        "reason",
        "engine",
        "budget",
        "executionPolicy",
        "settingsVersions"
      ],
      "additionalProperties": false
    },
    "RunPage": {
      "type": "object",
      "properties": {
        "scope": {
          "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/WorkspaceScope"
        },
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "https://beetle-lab.dev/contracts/api/v2/run#/$defs/Run"
          }
        },
        "nextCursor": {
          "anyOf": [
            {
              "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/OpaqueCursor"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "scope",
        "items",
        "nextCursor"
      ],
      "additionalProperties": false
    }
  }
}
