{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beetle-lab.dev/contracts/api/v2/installation-status",
  "title": "ApiInstallationStatus",
  "$defs": {
    "MeasuredQuantity": {
      "type": "object",
      "properties": {
        "status": { "const": "measured" },
        "value": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Count" }
      },
      "required": ["status", "value"],
      "additionalProperties": false
    },
    "UnmeasuredQuantity": {
      "type": "object",
      "properties": { "status": { "enum": ["unknown", "not_measured"] }, "value": { "type": "null" } },
      "required": ["status", "value"],
      "additionalProperties": false
    },
    "StatusQuantity": {
      "oneOf": [
        { "$ref": "https://beetle-lab.dev/contracts/api/v2/installation-status#/$defs/MeasuredQuantity" },
        { "$ref": "https://beetle-lab.dev/contracts/api/v2/installation-status#/$defs/UnmeasuredQuantity" }
      ]
    },
    "OptionalTimestamp": {
      "anyOf": [{ "$ref": "https://beetle-lab.dev/contracts/api/v2/run#/$defs/RunTimestamp" }, { "type": "null" }]
    },
    "OptionalPositive": {
      "anyOf": [{ "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/PositiveInteger" }, { "type": "null" }]
    },
    "AgentReachability": {
      "type": "object",
      "properties": {
        "state": { "enum": ["ready", "stale", "unavailable", "unreachable", "unknown", "disabled"] },
        "lastSeenAt": {
          "$ref": "https://beetle-lab.dev/contracts/api/v2/installation-status#/$defs/OptionalTimestamp"
        },
        "checkedAt": { "$ref": "https://beetle-lab.dev/contracts/api/v2/installation-status#/$defs/OptionalTimestamp" }
      },
      "required": ["state", "lastSeenAt", "checkedAt"],
      "additionalProperties": false
    },
    "HostFacts": {
      "type": "object",
      "properties": {
        "source": { "const": "docker-daemon" },
        "cpuCores": { "$ref": "https://beetle-lab.dev/contracts/api/v2/installation-status#/$defs/StatusQuantity" },
        "memoryTotalBytes": {
          "$ref": "https://beetle-lab.dev/contracts/api/v2/installation-status#/$defs/StatusQuantity"
        },
        "cpuUsedMillis": {
          "$ref": "https://beetle-lab.dev/contracts/api/v2/installation-status#/$defs/StatusQuantity"
        },
        "memoryAvailableBytes": {
          "$ref": "https://beetle-lab.dev/contracts/api/v2/installation-status#/$defs/StatusQuantity"
        }
      },
      "required": ["source", "cpuCores", "memoryTotalBytes", "cpuUsedMillis", "memoryAvailableBytes"],
      "additionalProperties": false
    },
    "DiskFacts": {
      "type": "object",
      "properties": {
        "backendFreeBytes": {
          "$ref": "https://beetle-lab.dev/contracts/api/v2/installation-status#/$defs/StatusQuantity"
        },
        "backendTotalBytes": {
          "$ref": "https://beetle-lab.dev/contracts/api/v2/installation-status#/$defs/StatusQuantity"
        },
        "stagingFreeBytes": {
          "$ref": "https://beetle-lab.dev/contracts/api/v2/installation-status#/$defs/StatusQuantity"
        },
        "freeSpaceReserveBytes": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Count" },
        "storageAllocationBytes": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Count" },
        "storageChargedBytes": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Count" }
      },
      "required": [
        "backendFreeBytes",
        "backendTotalBytes",
        "stagingFreeBytes",
        "freeSpaceReserveBytes",
        "storageAllocationBytes",
        "storageChargedBytes"
      ],
      "additionalProperties": false
    },
    "EngineImageStatus": {
      "type": "object",
      "properties": {
        "profileId": { "$ref": "https://beetle-lab.dev/contracts/api/v2/settings-values#/$defs/EngineProfile" },
        "imageDigest": { "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/imageDigest" },
        "image": { "enum": ["verified_at_agent_start", "unknown"] },
        "engine": { "$ref": "https://beetle-lab.dev/contracts/api/v2/installation-status#/$defs/EngineVersion" }
      },
      "required": ["profileId", "imageDigest", "image"],
      "additionalProperties": false
    },
    "EngineVersion": {
      "type": "object",
      "properties": {
        "id": {"$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/token"},
        "version": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001f\\u007f\\u2028\\u2029]+(?![\\s\\S])"},
        "configVersion": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}
      },
      "required": ["id", "version", "configVersion"],
      "additionalProperties": false
    },
    "SlotUsage": {
      "type": "object",
      "properties": {
        "used": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Count" },
        "runs": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Count" },
        "exports": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Count" },
        "configured": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/PositiveInteger" },
        "effective": { "$ref": "https://beetle-lab.dev/contracts/api/v2/installation-status#/$defs/OptionalPositive" }
      },
      "required": ["used", "runs", "exports", "configured", "effective"],
      "additionalProperties": false
    },
    "PoolUsage": {
      "type": "object",
      "properties": {
        "slots": { "$ref": "https://beetle-lab.dev/contracts/api/v2/installation-status#/$defs/SlotUsage" },
        "reservedCpuMillis": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Count" },
        "reservedMemoryBytes": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Count" },
        "poolCpuMillis": {
          "$ref": "https://beetle-lab.dev/contracts/api/v2/installation-status#/$defs/OptionalPositive"
        },
        "poolMemoryBytes": {
          "$ref": "https://beetle-lab.dev/contracts/api/v2/installation-status#/$defs/OptionalPositive"
        },
        "queuedRuns": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Count" },
        "queuedExports": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Count" }
      },
      "required": [
        "slots",
        "reservedCpuMillis",
        "reservedMemoryBytes",
        "poolCpuMillis",
        "poolMemoryBytes",
        "queuedRuns",
        "queuedExports"
      ],
      "additionalProperties": false
    },
    "InstallationStatus": {
      "type": "object",
      "properties": {
        "scope": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/InstallationScope" },
        "generatedAt": { "$ref": "https://beetle-lab.dev/contracts/api/v2/run#/$defs/RunTimestamp" },
        "agent": { "$ref": "https://beetle-lab.dev/contracts/api/v2/installation-status#/$defs/AgentReachability" },
        "host": { "$ref": "https://beetle-lab.dev/contracts/api/v2/installation-status#/$defs/HostFacts" },
        "disk": { "$ref": "https://beetle-lab.dev/contracts/api/v2/installation-status#/$defs/DiskFacts" },
        "engines": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "https://beetle-lab.dev/contracts/api/v2/installation-status#/$defs/EngineImageStatus" }
        },
        "pool": { "$ref": "https://beetle-lab.dev/contracts/api/v2/installation-status#/$defs/PoolUsage" }
      },
      "required": ["scope", "generatedAt", "agent", "host", "disk", "engines", "pool"],
      "additionalProperties": false
    },
    "RunSlotHolder": {
      "type": "object",
      "properties": {
        "runId": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Uuid" },
        "suiteId": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Uuid" },
        "suiteName": {
          "anyOf": [{ "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Name" }, { "type": "null" }]
        }
      },
      "required": ["runId", "suiteId", "suiteName"],
      "additionalProperties": false
    },
    "RunQueueStatus": {
      "type": "object",
      "properties": {
        "scope": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/WorkspaceScope" },
        "generatedAt": { "$ref": "https://beetle-lab.dev/contracts/api/v2/run#/$defs/RunTimestamp" },
        "runId": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Uuid" },
        "state": { "enum": ["queued", "dispatching", "active", "finalizing", "finished", "cancelled", "errored"] },
        "capacityBlockReason": {
          "anyOf": [
            { "enum": ["capacity_unknown", "profile_unavailable", "per_run_ceiling", "budget_unavailable", "staging_unavailable", "storage_unavailable", "ownership_unknown", "isolated"] },
            { "type": "null" }
          ]
        },
        "waiting": { "enum": ["backend_queue", "agent_admission", "not_waiting"] },
        "position": { "$ref": "https://beetle-lab.dev/contracts/api/v2/installation-status#/$defs/OptionalPositive" },
        "slots": { "$ref": "https://beetle-lab.dev/contracts/api/v2/installation-status#/$defs/SlotUsage" },
        "holders": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "https://beetle-lab.dev/contracts/api/v2/installation-status#/$defs/RunSlotHolder" }
        },
        "otherWorkspaceRuns": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Count" }
      },
      "required": [
        "scope",
        "generatedAt",
        "runId",
        "state",
        "waiting",
        "position",
        "slots",
        "holders",
        "otherWorkspaceRuns"
      ],
      "additionalProperties": false
    }
  }
}
