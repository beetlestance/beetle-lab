{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beetle-lab.dev/contracts/api/v2/run-metric-overview",
  "title": "ApiRunMetricOverview",
  "$defs": {
    "RunMetricEndpoint": {
      "type": "object",
      "properties": {
        "request": {
          "type": "string",
          "pattern": "^r[0-9]{1,3}$"
        },
        "requestCount": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "requestsPerSecond": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1.7976931348623157e+308
            },
            {
              "type": "null"
            }
          ]
        },
        "failure": {
          "anyOf": [
            {
              "$ref": "https://beetle-lab.dev/contracts/api/v2/run-metrics#/$defs/RunMetricRate"
            },
            {
              "type": "null"
            }
          ]
        },
        "latency": {
          "anyOf": [
            {
              "$ref": "https://beetle-lab.dev/contracts/api/v2/run-metrics#/$defs/RunMetricTrend"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "request",
        "requestCount",
        "requestsPerSecond",
        "failure",
        "latency"
      ],
      "additionalProperties": false
    },
    "RunMetricOverview": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Uuid"
        },
        "scope": {
          "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/WorkspaceScope"
        },
        "attemptId": {
          "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Uuid"
        },
        "availability": {
          "enum": [
            "pending",
            "not_recorded",
            "unsupported_format",
            "unavailable",
            "ready"
          ]
        },
        "source": {
          "anyOf": [
            {
              "$ref": "https://beetle-lab.dev/contracts/api/v2/run-history#/$defs/RunHistorySource"
            },
            {
              "type": "null"
            }
          ]
        },
        "scenarioStartedAtMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8640000000000000
        },
        "testDurationMs": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1.7976931348623157e+308
            },
            {
              "type": "null"
            }
          ]
        },
        "requestCount": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "requestsPerSecond": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1.7976931348623157e+308
            },
            {
              "type": "null"
            }
          ]
        },
        "failure": {
          "anyOf": [
            {
              "$ref": "https://beetle-lab.dev/contracts/api/v2/run-metrics#/$defs/RunMetricRate"
            },
            {
              "type": "null"
            }
          ]
        },
        "latency": {
          "anyOf": [
            {
              "$ref": "https://beetle-lab.dev/contracts/api/v2/run-metrics#/$defs/RunMetricTrend"
            },
            {
              "type": "null"
            }
          ]
        },
        "checks": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "passed": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "total": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "ratio": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "passed",
                "total",
                "ratio"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "droppedIterations": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "endpoints": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "https://beetle-lab.dev/contracts/api/v2/run-metric-overview#/$defs/RunMetricEndpoint"
          }
        },
        "omittedEndpoints": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      },
      "required": [
        "id",
        "scope",
        "attemptId",
        "availability",
        "source",
        "testDurationMs",
        "requestCount",
        "requestsPerSecond",
        "failure",
        "latency",
        "checks",
        "droppedIterations",
        "endpoints",
        "omittedEndpoints"
      ],
      "additionalProperties": false
    }
  }
}
