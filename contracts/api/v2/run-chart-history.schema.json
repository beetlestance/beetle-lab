{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beetle-lab.dev/contracts/api/v2/run-chart-history",
  "title": "ApiRunChartHistory",
  "$defs": {
    "RunChartPoint": {
      "type": "object",
      "properties": {
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "startTimeMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8640000000000000
        },
        "endTimeMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8640000000000000
        },
        "gapBefore": {
          "type": "boolean"
        },
        "requestCount": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "httpFailures": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "httpSamples": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "httpP50": {
          "anyOf": [
            {
              "$ref": "https://beetle-lab.dev/contracts/api/v2/run-metrics#/$defs/RunMetricPercentile"
            },
            {
              "type": "null"
            }
          ]
        },
        "httpP95": {
          "anyOf": [
            {
              "$ref": "https://beetle-lab.dev/contracts/api/v2/run-metrics#/$defs/RunMetricPercentile"
            },
            {
              "type": "null"
            }
          ]
        },
        "httpP99": {
          "anyOf": [
            {
              "$ref": "https://beetle-lab.dev/contracts/api/v2/run-metrics#/$defs/RunMetricPercentile"
            },
            {
              "type": "null"
            }
          ]
        },
        "vus": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1.7976931348623157e+308
            },
            {
              "type": "null"
            }
          ]
        },
        "vusMax": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1.7976931348623157e+308
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "sequence",
        "startTimeMs",
        "endTimeMs",
        "gapBefore",
        "requestCount",
        "httpFailures",
        "httpSamples",
        "httpP50",
        "httpP95",
        "httpP99",
        "vus",
        "vusMax"
      ],
      "additionalProperties": false
    },
    "RunChartHistory": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Uuid"
        },
        "scope": {
          "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/WorkspaceScope"
        },
        "attemptId": {
          "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Uuid"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "https://beetle-lab.dev/contracts/api/v2/run-history#/$defs/RunHistorySource"
            },
            {
              "type": "null"
            }
          ]
        },
        "windows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "sampled": {
          "type": "boolean"
        },
        "points": {
          "type": "array",
          "maxItems": 900,
          "items": {
            "$ref": "https://beetle-lab.dev/contracts/api/v2/run-chart-history#/$defs/RunChartPoint"
          }
        },
        "observedPeakRequestsPerSecond": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "knownRequestWindows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        },
        "reason": {
          "enum": [
            null,
            "pending",
            "not_recorded",
            "unsupported_format",
            "unavailable",
            "too_large"
          ]
        },
        "meanVus": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1.7976931348623157e+308
            },
            {
              "type": "null"
            }
          ]
        },
        "knownVusWindows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        }
      },
      "required": [
        "id",
        "scope",
        "attemptId",
        "source",
        "windows",
        "sampled",
        "points",
        "observedPeakRequestsPerSecond",
        "knownRequestWindows",
        "reason",
        "meanVus",
        "knownVusWindows"
      ],
      "additionalProperties": false
    }
  }
}
