{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beetle-lab.dev/contracts/api/v2/namespace-requests",
  "title": "ApiNamespaceRequests",
  "$defs": {
    "MutationIntent": {
      "type": "object",
      "properties": { "requestId": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Uuid" } },
      "required": ["requestId"]
    },
    "VersionedIntent": {
      "type": "object", "allOf": [{ "$ref": "https://beetle-lab.dev/contracts/api/v2/namespace-requests#/$defs/MutationIntent" }],
      "properties": { "expectedVersion": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Version" } },
      "required": ["expectedVersion"]
    },
    "CreateOrganizationRequest": {
      "type": "object", "allOf": [{ "$ref": "https://beetle-lab.dev/contracts/api/v2/namespace-requests#/$defs/MutationIntent" }],
      "properties": {
        "scope": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/InstallationScope" },
        "name": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Name" },
        "slug": { "$ref": "https://beetle-lab.dev/contracts/api/v2/namespace#/$defs/Organization/properties/slug" }
      },
      "required": ["scope", "name", "slug"], "unevaluatedProperties": false
    },
    "PatchOrganizationRequest": {
      "type": "object", "allOf": [{ "$ref": "https://beetle-lab.dev/contracts/api/v2/namespace-requests#/$defs/VersionedIntent" }],
      "properties": {
        "scope": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/InstallationScope" },
        "name": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Name" },
        "slug": { "$ref": "https://beetle-lab.dev/contracts/api/v2/namespace#/$defs/Organization/properties/slug" }
      },
      "required": ["scope"], "minProperties": 4, "unevaluatedProperties": false
    },
    "CreateWorkspaceRequest": {
      "type": "object", "allOf": [{ "$ref": "https://beetle-lab.dev/contracts/api/v2/namespace-requests#/$defs/MutationIntent" }],
      "properties": {
        "scope": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/OrganizationScope" },
        "name": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Name" }
      },
      "required": ["scope", "name"], "unevaluatedProperties": false
    },
    "PatchWorkspaceRequest": {
      "type": "object", "allOf": [{ "$ref": "https://beetle-lab.dev/contracts/api/v2/namespace-requests#/$defs/VersionedIntent" }],
      "properties": {
        "scope": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/OrganizationScope" },
        "name": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Name" }
      },
      "required": ["scope", "name"], "unevaluatedProperties": false
    },
    "CreateFolderRequest": {
      "type": "object", "allOf": [{ "$ref": "https://beetle-lab.dev/contracts/api/v2/namespace-requests#/$defs/MutationIntent" }],
      "properties": {
        "scope": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/WorkspaceScope" },
        "name": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Name" },
        "parentFolderId": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Uuid" }
      },
      "required": ["scope", "name", "parentFolderId"], "unevaluatedProperties": false
    },
    "PatchFolderRequest": {
      "type": "object", "allOf": [{ "$ref": "https://beetle-lab.dev/contracts/api/v2/namespace-requests#/$defs/VersionedIntent" }],
      "properties": {
        "scope": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/WorkspaceScope" },
        "name": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Name" },
        "parentFolderId": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Uuid" }
      },
      "required": ["scope"], "minProperties": 4, "unevaluatedProperties": false
    },
    "DeleteOrganizationRequest": {
      "type": "object", "allOf": [{ "$ref": "https://beetle-lab.dev/contracts/api/v2/namespace-requests#/$defs/VersionedIntent" }],
      "properties": { "scope": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/InstallationScope" } },
      "required": ["scope"], "unevaluatedProperties": false
    },
    "DeleteWorkspaceRequest": {
      "type": "object", "allOf": [{ "$ref": "https://beetle-lab.dev/contracts/api/v2/namespace-requests#/$defs/VersionedIntent" }],
      "properties": { "scope": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/OrganizationScope" } },
      "required": ["scope"], "unevaluatedProperties": false
    },
    "DeleteFolderRequest": {
      "type": "object", "allOf": [{ "$ref": "https://beetle-lab.dev/contracts/api/v2/namespace-requests#/$defs/VersionedIntent" }],
      "properties": { "scope": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/WorkspaceScope" } },
      "required": ["scope"], "unevaluatedProperties": false
    }
  }
}
