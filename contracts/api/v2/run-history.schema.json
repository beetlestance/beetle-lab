{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beetle-lab.dev/contracts/api/v2/run-history",
  "title": "ApiRunHistory",
  "$defs": {
    "RunHistorySource": {
      "type": "object",
      "properties": {
        "generation": {
          "const": 1
        },
        "manifestDigest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "numericArtifactId": {
          "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Uuid"
        },
        "numericSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "numericVersion": {
          "enum": [
            3,
            4
          ]
        },
        "measurementSourceTimeMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8640000000000000
        },
        "coverage": {
          "$ref": "https://beetle-lab.dev/contracts/api/v2/run-metrics#/$defs/RunMetricCoverage"
        }
      },
      "additionalProperties": false,
      "required": [
        "generation",
        "manifestDigest",
        "numericArtifactId",
        "numericSha256",
        "numericVersion",
        "measurementSourceTimeMs",
        "coverage"
      ]
    },
    "RunHistorySummary": {
      "type": "object",
      "properties": {
        "runId": {
          "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Uuid"
        },
        "attemptId": {
          "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Uuid"
        },
        "availability": {
          "enum": [
            "pending",
            "ready",
            "not_recorded",
            "unsupported_format",
            "unavailable"
          ]
        },
        "source": {
          "anyOf": [
            {
              "$ref": "https://beetle-lab.dev/contracts/api/v2/run-history#/$defs/RunHistorySource"
            },
            {
              "type": "null"
            }
          ]
        },
        "testDurationMs": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1.7976931348623157e+308
            },
            {
              "type": "null"
            }
          ]
        },
        "requestCount": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "requestsPerSecond": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1.7976931348623157e+308
            },
            {
              "type": "null"
            }
          ]
        },
        "httpFailures": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "httpSamples": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "httpFailureRatio": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "httpP95": {
          "anyOf": [
            {
              "$ref": "https://beetle-lab.dev/contracts/api/v2/run-metrics#/$defs/RunMetricPercentile"
            },
            {
              "type": "null"
            }
          ]
        },
        "publishedArtifactBytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "retainedLogicalBytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "metadataAllowanceBytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "runId",
        "attemptId",
        "availability",
        "source",
        "testDurationMs",
        "requestCount",
        "requestsPerSecond",
        "httpFailures",
        "httpSamples",
        "httpFailureRatio",
        "httpP95",
        "publishedArtifactBytes",
        "retainedLogicalBytes",
        "metadataAllowanceBytes"
      ],
      "additionalProperties": false
    }
  }
}
