{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beetle-lab.dev/contracts/api/v2/retention",
  "title": "ApiRetention",
  "$defs": {
    "RetentionPreviewRequest": {
      "type": "object", "allOf": [{ "$ref": "https://beetle-lab.dev/contracts/api/v2/namespace-requests#/$defs/VersionedIntent" }],
      "properties": {
        "scope": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/SettingsScope" },
        "settingsId": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Uuid" },
        "page": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/PageQuery" }
      },
      "required": ["scope", "settingsId", "page"], "unevaluatedProperties": false
    },
    "RetentionCandidate": {
      "type": "object",
      "properties": {
        "id": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Uuid" },
        "version": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Version" },
        "scope": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/WorkspaceScope" },
        "estimatedBytes": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Count" },
        "reason": { "enum": ["age", "completed_count", "storage_budget"] }
      },
      "required": ["id", "version", "scope", "estimatedBytes", "reason"], "additionalProperties": false
    },
    "ProtectedExclusion": {
      "type": "object",
      "properties": {
        "reason": { "enum": ["active", "pinned", "referenced_input", "cleanup_in_progress"] },
        "count": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Count" },
        "estimatedBytes": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Count" }
      },
      "required": ["reason", "count", "estimatedBytes"], "additionalProperties": false
    },
    "RetentionPreview": {
      "description": "One bounded page of immutable snapshot candidates; byte estimates are not freed bytes. Cursor is bound to snapshot, settings version and scope by the consumer.",
      "type": "object",
      "properties": {
        "snapshotId": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Uuid" },
        "version": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Version" },
        "scope": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/SettingsScope" },
        "requestId": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Uuid" },
        "settingsId": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Uuid" },
        "settingsVersion": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Version" },
        "policy": { "$ref": "https://beetle-lab.dev/contracts/api/v2/settings-values#/$defs/RetentionPolicy" },
        "candidates": { "type": "array", "maxItems": 100, "items": { "$ref": "https://beetle-lab.dev/contracts/api/v2/retention#/$defs/RetentionCandidate" } },
        "estimatedBytes": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Count" },
        "protectedExclusions": { "type": "array", "maxItems": 4, "items": { "$ref": "https://beetle-lab.dev/contracts/api/v2/retention#/$defs/ProtectedExclusion" } },
        "nextCursor": { "anyOf": [{ "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/OpaqueCursor" }, { "type": "null" }] }
      },
      "required": ["snapshotId", "version", "scope", "requestId", "settingsId", "settingsVersion", "policy", "candidates", "estimatedBytes", "protectedExclusions", "nextCursor"],
      "additionalProperties": false
    },
    "RetentionApplyRequest": {
      "description": "Explicit admission of at most one bounded page. Revalidate ownership, versions, active/pinned/referenced constraints before each deletion.",
      "type": "object", "allOf": [{ "$ref": "https://beetle-lab.dev/contracts/api/v2/namespace-requests#/$defs/VersionedIntent" }],
      "properties": {
        "scope": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/SettingsScope" },
        "settingsId": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Uuid" },
        "snapshotId": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Uuid" },
        "snapshotVersion": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Version" },
        "page": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/PageQuery" }
      },
      "required": ["scope", "settingsId", "snapshotId", "snapshotVersion", "page"], "unevaluatedProperties": false
    },
    "RetentionApplyReceipt": {
      "description": "Admitted bounded maintenance work, not completed cleanup or evidence of freed space.",
      "type": "object",
      "properties": {
        "id": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Uuid" },
        "version": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Version" },
        "scope": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/SettingsScope" },
        "requestId": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Uuid" },
        "settingsId": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Uuid" },
        "settingsVersion": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Version" },
        "snapshotId": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Uuid" },
        "snapshotVersion": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/Version" },
        "state": { "const": "admitted" },
        "maximumCandidates": { "type": "integer", "minimum": 1, "maximum": 100 }
      },
      "required": ["id", "version", "scope", "requestId", "settingsId", "settingsVersion", "snapshotId", "snapshotVersion", "state", "maximumCandidates"],
      "additionalProperties": false
    }
  }
}
