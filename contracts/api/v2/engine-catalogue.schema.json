{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beetle-lab.dev/contracts/api/v2/engine-catalogue",
  "title": "ApiEngineCatalogue",
  "$defs": {
    "EngineCatalogueEntry": {
      "type": "object",
      "description": "One engine. installed engines list the profiles the agent pins, with the image facts it reported at start; planned engines have no profiles and cannot run.",
      "properties": {
        "id": { "enum": ["k6", "unit-tests", "integration-tests", "lint", "formatting", "mutation-testing"] },
        "availability": { "enum": ["installed", "planned"] },
        "state": { "enum": ["ready", "unavailable", "unknown", "disabled", "planned"] },
        "profiles": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "https://beetle-lab.dev/contracts/api/v2/installation-status#/$defs/EngineImageStatus" }
        }
      },
      "required": ["id", "availability", "state", "profiles"],
      "additionalProperties": false
    },
    "EngineCatalogue": {
      "type": "object",
      "description": "Installed and planned engines. state follows the agent: ready only while it reports fresh facts; it never contacts the agent.",
      "properties": {
        "scope": { "$ref": "https://beetle-lab.dev/contracts/api/v2/common#/$defs/InstallationScope" },
        "generatedAt": { "$ref": "https://beetle-lab.dev/contracts/api/v2/run#/$defs/RunTimestamp" },
        "engines": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "https://beetle-lab.dev/contracts/api/v2/engine-catalogue#/$defs/EngineCatalogueEntry" }
        }
      },
      "required": ["scope", "generatedAt", "engines"],
      "additionalProperties": false
    }
  }
}
