{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beetle-lab.dev/contracts/runner/v1/attempt-snapshot",
  "title": "AttemptSnapshot",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "const": "1.0"
    },
    "organizationId": {
      "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/uuid"
    },
    "workspaceId": {
      "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/uuid"
    },
    "attemptId": {
      "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/uuid"
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "intentDigest": {
      "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/sha256"
    },
    "state": {
      "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/attemptState"
    },
    "phase": {
      "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/phase"
    },
    "lastSeq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "retainedStartSeq": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "cancelRequested": {
      "type": "boolean"
    },
    "exitEvidence": {
      "type": "object",
      "properties": {
        "exitCode": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "oomKilled": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "reason": {
          "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/reason"
        },
        "observedAt": {
          "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/timestamp"
        }
      },
      "required": [
        "exitCode",
        "oomKilled",
        "observedAt"
      ],
      "additionalProperties": false
    },
    "result": {
      "$ref": "https://beetle-lab.dev/contracts/runner/v1/engine-result"
    }
  },
  "required": [
    "protocolVersion",
    "organizationId",
    "workspaceId",
    "attemptId",
    "generation",
    "intentDigest",
    "state",
    "lastSeq",
    "retainedStartSeq",
    "cancelRequested"
  ],
  "additionalProperties": false
}
