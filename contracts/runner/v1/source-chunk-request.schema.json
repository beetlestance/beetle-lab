{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beetle-lab.dev/contracts/runner/v1/source-chunk-request",
  "title": "SourceChunkRequest",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "manifestDigest": {
      "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/sha256"
    },
    "sourceDigest": {
      "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/sha256"
    },
    "artifactId": {
      "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/uuid"
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "length": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65536
    }
  },
  "required": [
    "version",
    "manifestDigest",
    "sourceDigest",
    "artifactId",
    "offset",
    "length"
  ],
  "additionalProperties": false
}
