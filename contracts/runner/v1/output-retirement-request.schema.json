{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beetle-lab.dev/contracts/runner/v1/output-retirement-request",
  "title": "OutputRetirementRequest",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "purpose": {
      "const": "performance"
    },
    "organizationId": {
      "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/uuid"
    },
    "workspaceId": {
      "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/uuid"
    },
    "attemptId": {
      "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/uuid"
    },
    "journalAuthority": {
      "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/uuid"
    },
    "runId": {
      "allOf": [
        {
          "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/uuid"
        },
        {
          "pattern": "^[0-9a-f-]+$",
          "type": "string"
        }
      ]
    },
    "deletionId": {
      "allOf": [
        {
          "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/uuid"
        },
        {
          "pattern": "^[0-9a-f-]+$",
          "type": "string"
        }
      ]
    },
    "generation": {
      "const": 1
    },
    "intentDigest": {
      "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/sha256"
    },
    "deletionVersion": {
      "const": 1
    },
    "closure": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "source"
            },
            "sourceDigest": {
              "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/sha256"
            },
            "manifestDigest": {
              "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/sha256"
            },
            "finalAgentSeq": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "kind",
            "sourceDigest",
            "manifestDigest",
            "finalAgentSeq"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "absence"
            },
            "proofDigest": {
              "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/sha256"
            },
            "finalAgentSeq": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "kind",
            "proofDigest",
            "finalAgentSeq"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "version",
    "purpose",
    "organizationId",
    "workspaceId",
    "attemptId",
    "journalAuthority",
    "runId",
    "deletionId",
    "generation",
    "intentDigest",
    "deletionVersion",
    "closure"
  ],
  "additionalProperties": false
}
