{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beetle-lab.dev/contracts/runner/v1/capacity-observation",
  "title": "CapacityObservation",
  "type": "object",
  "properties": {
    "installationId": {
      "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/uuid"
    },
    "daemonId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9:._-]{1,128}$"
    },
    "policyDigest": {
      "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/sha256"
    },
    "clock": {
      "const": "local-shared-wall"
    },
    "source": {
      "$ref": "https://beetle-lab.dev/contracts/runner/v1/capacity-observation#/$defs/label"
    },
    "sampleStartedAtMs": {
      "$ref": "https://beetle-lab.dev/contracts/runner/v1/capacity-observation#/$defs/milliseconds"
    },
    "observedAtMs": {
      "$ref": "https://beetle-lab.dev/contracts/runner/v1/capacity-observation#/$defs/milliseconds"
    },
    "expiresAtMs": {
      "$ref": "https://beetle-lab.dev/contracts/runner/v1/capacity-observation#/$defs/milliseconds"
    },
    "observationTtlMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 300000
    },
    "pool": {
      "$ref": "https://beetle-lab.dev/contracts/runner/v1/capacity-observation#/$defs/resources"
    },
    "perRunStagingBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "maxConcurrent": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "provenance": {
      "$ref": "https://beetle-lab.dev/contracts/runner/v1/capacity-observation#/$defs/provenance"
    },
    "diskSource": {
      "enum": [
        "statfs",
        "synthetic"
      ]
    },
    "freeStagingDiskBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "physicalPidCapacity": {
      "type": "null"
    },
    "runtimeControls": {
      "type": "array",
      "items": {
        "enum": [
          "cpu",
          "memory",
          "pids"
        ]
      },
      "uniqueItems": true,
      "maxItems": 3
    },
    "guards": {
      "type": "object",
      "properties": {
        "source": {
          "const": "supervisor"
        },
        "observedAtMs": {
          "$ref": "https://beetle-lab.dev/contracts/runner/v1/capacity-observation#/$defs/milliseconds"
        },
        "controls": {
          "type": "array",
          "items": {
            "enum": [
              "timeout",
              "output"
            ]
          },
          "uniqueItems": true,
          "minItems": 2,
          "maxItems": 2
        }
      },
      "required": [
        "source",
        "observedAtMs",
        "controls"
      ],
      "additionalProperties": false
    },
    "requiredSensors": {
      "type": "array",
      "items": {
        "enum": [
          "idle",
          "thermal"
        ]
      },
      "uniqueItems": true,
      "maxItems": 2
    },
    "idle": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "https://beetle-lab.dev/contracts/runner/v1/capacity-observation#/$defs/label"
        },
        "observedAtMs": {
          "$ref": "https://beetle-lab.dev/contracts/runner/v1/capacity-observation#/$defs/milliseconds"
        },
        "value": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "source",
        "observedAtMs",
        "value"
      ],
      "additionalProperties": false
    },
    "thermal": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "https://beetle-lab.dev/contracts/runner/v1/capacity-observation#/$defs/label"
        },
        "observedAtMs": {
          "$ref": "https://beetle-lab.dev/contracts/runner/v1/capacity-observation#/$defs/milliseconds"
        },
        "celsius": {
          "type": [
            "number",
            "null"
          ],
          "minimum": -100,
          "maximum": 300
        }
      },
      "required": [
        "source",
        "observedAtMs",
        "celsius"
      ],
      "additionalProperties": false
    },
    "thermalPolicy": {
      "type": "object",
      "properties": {
        "source": {
          "$ref": "https://beetle-lab.dev/contracts/runner/v1/capacity-observation#/$defs/label"
        },
        "configuredAtMs": {
          "$ref": "https://beetle-lab.dev/contracts/runner/v1/capacity-observation#/$defs/milliseconds"
        },
        "maximumCelsius": {
          "type": "number",
          "minimum": -100,
          "maximum": 300
        }
      },
      "required": [
        "source",
        "configuredAtMs",
        "maximumCelsius"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "installationId",
    "daemonId",
    "policyDigest",
    "clock",
    "source",
    "sampleStartedAtMs",
    "observedAtMs",
    "expiresAtMs",
    "observationTtlMs",
    "pool",
    "perRunStagingBytes",
    "maxConcurrent",
    "provenance",
    "diskSource",
    "freeStagingDiskBytes",
    "physicalPidCapacity",
    "runtimeControls",
    "guards",
    "requiredSensors"
  ],
  "additionalProperties": false,
  "$defs": {
    "milliseconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8640000000000000
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "resources": {
      "type": "object",
      "properties": {
        "cpuMillis": {
          "type": "integer",
          "minimum": 1,
          "maximum": 35184372088831
        },
        "memoryBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 35184372088831
        },
        "pids": {
          "type": "integer",
          "minimum": 1,
          "maximum": 35184372088831
        },
        "outputBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 35184372088831
        },
        "stagingBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 35184372088831
        }
      },
      "required": [
        "cpuMillis",
        "memoryBytes",
        "pids",
        "outputBytes",
        "stagingBytes"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "cpuMillis": {
          "enum": [
            "docker-info",
            "synthetic"
          ]
        },
        "memoryBytes": {
          "enum": [
            "docker-info",
            "synthetic"
          ]
        },
        "pids": {
          "enum": [
            "configured-policy",
            "synthetic"
          ]
        },
        "outputBytes": {
          "enum": [
            "configured-policy",
            "synthetic"
          ]
        },
        "stagingBytes": {
          "enum": [
            "configured-policy",
            "synthetic"
          ]
        }
      },
      "required": [
        "cpuMillis",
        "memoryBytes",
        "pids",
        "outputBytes",
        "stagingBytes"
      ],
      "additionalProperties": false
    }
  }
}
