{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beetle-lab.dev/contracts/runner/v1/error",
  "title": "ProtocolError",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "const": "1.0"
    },
    "organizationId": {
      "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/uuid"
    },
    "workspaceId": {
      "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/uuid"
    },
    "attemptId": {
      "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/uuid"
    },
    "reason": {
      "anyOf": [
        {
          "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/reason"
        },
        {
          "enum": [
            "authority_mismatch",
            "attempt_not_found"
          ]
        }
      ]
    },
    "retry": {
      "enum": [
        "never",
        "transport",
        "setup"
      ]
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 256
          },
          "code": {
            "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/token"
          }
        },
        "required": [
          "path",
          "code"
        ],
        "additionalProperties": false
      },
      "maxItems": 32
    },
    "cursorRecovery": {
      "type": "object",
      "properties": {
        "retainedStartSeq": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "snapshotAvailable": {
          "const": true
        },
        "sealArtifactId": {
          "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/uuid"
        }
      },
      "required": [
        "retainedStartSeq",
        "snapshotAvailable"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocolVersion",
    "organizationId",
    "workspaceId",
    "reason",
    "retry",
    "issues"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "reason": {
            "const": "attempt_not_found"
          }
        },
        "required": [
          "reason"
        ]
      },
      "then": {
        "required": [
          "attemptId"
        ],
        "properties": {
          "attemptId": {
            "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/uuid"
          }
        }
      }
    }
  ]
}
