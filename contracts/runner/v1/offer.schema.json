{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beetle-lab.dev/contracts/runner/v1/offer",
  "title": "Offer",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "const": "1.0"
    },
    "organizationId": {
      "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/uuid"
    },
    "workspaceId": {
      "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/uuid"
    },
    "attemptId": {
      "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/uuid"
    },
    "intentDigest": {
      "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/sha256"
    },
    "engine": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/token"
        },
        "imageDigest": {
          "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/imageDigest"
        },
        "configVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "imageDigest",
        "configVersion"
      ],
      "additionalProperties": false
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/uuid"
          },
          "sha256": {
            "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/sha256"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "sha256",
          "bytes"
        ],
        "additionalProperties": false
      },
      "maxItems": 128
    },
    "budget": {
      "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/budget"
    },
    "executionPolicy": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "parallel",
            "isolated"
          ]
        },
        "preferIdle": {
          "type": "boolean"
        }
      },
      "required": [
        "mode",
        "preferIdle"
      ],
      "additionalProperties": false
    },
    "requiredCapabilities": {
      "type": "array",
      "items": {
        "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/token"
      },
      "maxItems": 64
    },
    "secretReferences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/token"
          },
          "provider": {
            "enum": [
              "env",
              "mounted"
            ]
          },
          "reference": {
            "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/token"
          },
          "version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "name",
          "provider",
          "reference"
        ],
        "additionalProperties": false
      },
      "maxItems": 64
    },
    "config": {
      "type": "object",
      "maxProperties": 256,
      "propertyNames": {
        "maxLength": 128
      },
      "additionalProperties": true
    }
  },
  "required": [
    "protocolVersion",
    "organizationId",
    "workspaceId",
    "attemptId",
    "intentDigest",
    "engine",
    "inputs",
    "budget",
    "executionPolicy",
    "requiredCapabilities",
    "config"
  ],
  "additionalProperties": false
}
