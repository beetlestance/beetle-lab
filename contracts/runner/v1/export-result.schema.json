{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beetle-lab.dev/contracts/runner/v1/export-result",
  "title": "StandaloneExportResult",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "purpose": {
      "const": "standalone_export"
    },
    "exportId": {
      "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/uuid"
    },
    "attemptId": {
      "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/uuid"
    },
    "organizationId": {
      "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/uuid"
    },
    "workspaceId": {
      "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/uuid"
    },
    "generation": {
      "const": 1
    },
    "assignmentDigest": {
      "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/sha256"
    },
    "status": {
      "enum": [
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "artifact": {
      "anyOf": [
        {
          "allOf": [
            {
              "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/artifact"
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "standalone-k6-script"
                },
                "relativePath": {
                  "const": "standalone/suite.js"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 67108864
                }
              }
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "buildUsage": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 67108864
            },
            "peakBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 67108864
            }
          },
          "required": [
            "bytes",
            "peakBytes"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "seal": {
      "$ref": "https://beetle-lab.dev/contracts/runner/v1/result-evidence#/$defs/seal"
    }
  },
  "required": [
    "version",
    "purpose",
    "exportId",
    "attemptId",
    "organizationId",
    "workspaceId",
    "generation",
    "assignmentDigest",
    "status",
    "reason",
    "artifact",
    "buildUsage",
    "seal"
  ],
  "additionalProperties": false,
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "status": {
          "const": "succeeded"
        },
        "reason": {
          "type": "null"
        },
        "artifact": {
          "allOf": [
            {
              "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/artifact"
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "standalone-k6-script"
                },
                "relativePath": {
                  "const": "standalone/suite.js"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 67108864
                }
              }
            }
          ]
        },
        "buildUsage": {
          "type": "object",
          "properties": {
            "bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 67108864
            },
            "peakBytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 67108864
            }
          },
          "required": [
            "bytes",
            "peakBytes"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "status": {
          "const": "failed"
        },
        "reason": {
          "enum": [
            "unsupported_secrets",
            "invalid_input",
            "build_failed",
            "output_limit",
            "deadline",
            "clock_fenced",
            "input_integrity",
            "publication_failed"
          ]
        },
        "artifact": {
          "type": "null"
        }
      }
    },
    {
      "type": "object",
      "properties": {
        "status": {
          "const": "cancelled"
        },
        "reason": {
          "const": "cancelled"
        },
        "artifact": {
          "type": "null"
        }
      }
    }
  ]
}
