{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beetle-lab.dev/contracts/runner/v1/load-warning-artifact",
  "title": "LoadWarningArtifact",
  "type": "object",
  "properties": {
    "format": {
      "const": "beetle-k6-warnings"
    },
    "version": {
      "const": 1
    },
    "scope": {
      "type": "object",
      "properties": {
        "organizationId": {
          "type": "string",
          "format": "uuid",
          "maxLength": 45
        },
        "workspaceId": {
          "type": "string",
          "format": "uuid",
          "maxLength": 45
        },
        "attemptId": {
          "type": "string",
          "format": "uuid",
          "maxLength": 45
        },
        "generation": {
          "const": 1
        }
      },
      "required": [
        "organizationId",
        "workspaceId",
        "attemptId",
        "generation"
      ],
      "additionalProperties": false
    },
    "native": {
      "type": "object",
      "properties": {
        "coverage": {
          "enum": [
            "complete",
            "partial"
          ]
        },
        "insufficientVus": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "highCardinality": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxDuration": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "otherWarnings": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "discardedSegments": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "coverage",
        "insufficientVus",
        "highCardinality",
        "maxDuration",
        "otherWarnings",
        "discardedSegments"
      ],
      "additionalProperties": false
    },
    "configuration": {
      "type": "object",
      "properties": {
        "scenarioCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "arrival": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "executor": {
                  "enum": [
                    "constant-arrival-rate",
                    "ramping-arrival-rate",
                    "ramp-until"
                  ]
                },
                "peakIterationsPerSecond": {
                  "type": "number",
                  "exclusiveMinimum": 0,
                  "maximum": 1000000000.0
                },
                "preAllocatedVUs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100000
                },
                "maxVUs": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 100000
                }
              },
              "required": [
                "executor",
                "peakIterationsPerSecond",
                "preAllocatedVUs",
                "maxVUs"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "scenarioCount",
        "arrival"
      ],
      "additionalProperties": false
    },
    "iteration": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "estimate": {
              "type": "number",
              "minimum": 0,
              "maximum": 1e+100,
              "exclusiveMinimum": 0
            },
            "lower": {
              "type": "number",
              "minimum": 0,
              "maximum": 1e+100
            },
            "upper": {
              "type": "number",
              "minimum": 0,
              "maximum": 1e+100
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "estimate",
            "lower",
            "upper",
            "count"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "format",
    "version",
    "scope",
    "native",
    "configuration",
    "iteration"
  ],
  "additionalProperties": false
}
