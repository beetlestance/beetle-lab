{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beetle-lab.dev/contracts/runner/v1/result-evidence",
  "title": "ResultEvidence",
  "$defs": {
    "assertions": {
      "type": "object",
      "properties": {
        "required": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "passed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "failed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unknown": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "required",
        "passed",
        "failed",
        "unknown"
      ],
      "additionalProperties": false
    },
    "threshold": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/token"
        },
        "purpose": {
          "enum": [
            "slo",
            "discovery"
          ]
        },
        "passed": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "purpose",
        "passed"
      ],
      "additionalProperties": false
    },
    "seal": {
      "type": "object",
      "properties": {
        "sha256": {
          "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/sha256"
        },
        "sealedAt": {
          "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/timestamp"
        }
      },
      "required": [
        "sha256",
        "sealedAt"
      ],
      "additionalProperties": false
    },
    "base": {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "const": "1.0"
        },
        "organizationId": {
          "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/uuid"
        },
        "workspaceId": {
          "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/uuid"
        },
        "attemptId": {
          "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/uuid"
        },
        "generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "schemaId": {
          "const": "https://beetle-lab.dev/contracts/runner/v1/engine-result"
        },
        "engineId": {
          "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/token"
        },
        "requiredAssertions": {
          "$ref": "https://beetle-lab.dev/contracts/runner/v1/result-evidence#/$defs/assertions"
        },
        "thresholds": {
          "type": "array",
          "items": {
            "$ref": "https://beetle-lab.dev/contracts/runner/v1/result-evidence#/$defs/threshold"
          },
          "maxItems": 256
        },
        "completeness": {
          "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/completeness"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/artifact"
          },
          "maxItems": 128
        },
        "seal": {
          "$ref": "https://beetle-lab.dev/contracts/runner/v1/result-evidence#/$defs/seal"
        }
      },
      "required": [
        "protocolVersion",
        "organizationId",
        "workspaceId",
        "attemptId",
        "generation",
        "schemaId",
        "engineId",
        "requiredAssertions",
        "thresholds",
        "completeness",
        "artifacts",
        "seal"
      ]
    }
  }
}
