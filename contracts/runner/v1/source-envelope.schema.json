{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beetle-lab.dev/contracts/runner/v1/source-envelope",
  "title": "SourceEnvelope",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "manifest": {
      "$ref": "https://beetle-lab.dev/contracts/runner/v1/output-manifest"
    },
    "sourceDigest": {
      "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/sha256"
    },
    "closure": {
      "$ref": "https://beetle-lab.dev/contracts/runner/v1/source-values#/$defs/closure"
    }
  },
  "required": [
    "version",
    "manifest",
    "sourceDigest",
    "closure"
  ],
  "additionalProperties": false
}
