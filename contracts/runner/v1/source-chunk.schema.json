{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beetle-lab.dev/contracts/runner/v1/source-chunk",
  "title": "SourceChunk",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "manifestDigest": {
      "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/sha256"
    },
    "sourceDigest": {
      "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/sha256"
    },
    "artifactId": {
      "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/uuid"
    },
    "offset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "nextOffset": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "totalBytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "eof": {
      "type": "boolean"
    },
    "base64": {
      "type": "string",
      "maxLength": 87384,
      "pattern": "^[A-Za-z0-9+/]*={0,2}$"
    }
  },
  "required": [
    "version",
    "manifestDigest",
    "sourceDigest",
    "artifactId",
    "offset",
    "nextOffset",
    "totalBytes",
    "eof",
    "base64"
  ],
  "additionalProperties": false
}
