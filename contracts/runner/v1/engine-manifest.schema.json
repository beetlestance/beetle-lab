{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beetle-lab.dev/contracts/runner/v1/engine-manifest",
  "title": "EngineManifest",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "const": "1.0"
    },
    "engineId": {
      "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/token"
    },
    "engineVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "imageDigest": {
      "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/imageDigest"
    },
    "protocolRange": {
      "type": "object",
      "properties": {
        "minimum": {
          "const": "1.0"
        },
        "maximum": {
          "const": "1.0"
        }
      },
      "required": [
        "minimum",
        "maximum"
      ],
      "additionalProperties": false
    },
    "schemas": {
      "type": "object",
      "properties": {
        "config": {
          "type": "string",
          "format": "uri",
          "maxLength": 512
        },
        "result": {
          "enum": [
            "https://beetle-lab.dev/contracts/runner/v1/engine-result",
            "https://beetle-lab.dev/contracts/runner/v1/export-result"
          ]
        }
      },
      "required": [
        "config",
        "result"
      ],
      "additionalProperties": false
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/token"
      },
      "maxItems": 64
    },
    "supportedControls": {
      "type": "array",
      "items": {
        "enum": [
          "cpu",
          "memory",
          "pids",
          "timeout",
          "output"
        ]
      },
      "maxItems": 5
    },
    "defaultBudget": {
      "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/budget"
    },
    "minimumBudget": {
      "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/budget"
    },
    "backends": {
      "type": "array",
      "items": {
        "const": "docker"
      },
      "minItems": 1,
      "maxItems": 1
    },
    "network": {
      "type": "object",
      "properties": {
        "required": {
          "type": "boolean"
        },
        "profile": {
          "enum": [
            "none",
            "target-egress"
          ]
        }
      },
      "required": [
        "required",
        "profile"
      ],
      "additionalProperties": false
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "phase": {
            "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/phase"
          },
          "timeoutMs": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "workUnits": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "outputBytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "phase",
          "timeoutMs",
          "workUnits",
          "outputBytes"
        ],
        "additionalProperties": false
      },
      "minItems": 5,
      "maxItems": 5,
      "allOf": [
        {
          "contains": {
            "type": "object",
            "properties": {
              "phase": {
                "const": "validate"
              }
            },
            "required": [
              "phase"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "phase": {
                "const": "prepare"
              }
            },
            "required": [
              "phase"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "phase": {
                "const": "execute"
              }
            },
            "required": [
              "phase"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "phase": {
                "const": "collect"
              }
            },
            "required": [
              "phase"
            ]
          }
        },
        {
          "contains": {
            "type": "object",
            "properties": {
              "phase": {
                "const": "seal"
              }
            },
            "required": [
              "phase"
            ]
          }
        }
      ]
    },
    "entrypoint": {
      "type": "object",
      "properties": {
        "executable": {
          "$ref": "https://beetle-lab.dev/contracts/runner/v1/common#/$defs/token"
        },
        "arguments": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 256
          }
        }
      },
      "required": [
        "executable",
        "arguments"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "protocolVersion",
    "engineId",
    "engineVersion",
    "imageDigest",
    "protocolRange",
    "schemas",
    "capabilities",
    "supportedControls",
    "defaultBudget",
    "minimumBudget",
    "backends",
    "network",
    "phases",
    "entrypoint"
  ],
  "additionalProperties": false
}
