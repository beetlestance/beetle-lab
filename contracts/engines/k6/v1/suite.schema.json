{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beetle.test/contracts/engines/k6/v1/suite",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "loadPlan",
    "target",
    "requests",
    "datasets",
    "secrets",
    "selections"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "loadPlan": {
      "$ref": "https://beetle.test/contracts/engines/k6/v1/load-plan"
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "requests": {
      "type": "array",
      "items": {
        "$ref": "https://beetle.test/contracts/engines/k6/v1/requests"
      },
      "minItems": 1,
      "maxItems": 64
    },
    "datasets": {
      "type": "array",
      "items": {
        "$ref": "https://beetle.test/contracts/engines/k6/v1/datasets"
      },
      "minItems": 0,
      "maxItems": 64
    },
    "secrets": {
      "type": "array",
      "items": {
        "$ref": "https://beetle.test/contracts/engines/k6/v1/suite-common#/$defs/secret"
      },
      "minItems": 0,
      "maxItems": 64
    },
    "selections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenarioId",
          "entries"
        ],
        "properties": {
          "scenarioId": {
            "$ref": "https://beetle.test/contracts/engines/k6/v1/common#/$defs/identifier"
          },
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "requestId",
                "weight",
                "wait"
              ],
              "properties": {
                "requestId": {
                  "$ref": "https://beetle.test/contracts/engines/k6/v1/common#/$defs/identifier"
                },
                "weight": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000
                },
                "maxIterationsPerVu": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 1000000000
                },
                "wait": {
                  "$ref": "https://beetle.test/contracts/engines/k6/v1/suite-common#/$defs/wait"
                }
              }
            },
            "minItems": 1,
            "maxItems": 64
          }
        }
      },
      "minItems": 1,
      "maxItems": 64
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "attempts",
        "intervalMs",
        "timeoutMs",
        "wallBudgetMs",
        "expectedStatus",
        "assertions"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "attempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "intervalMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60000
        },
        "wallBudgetMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 86400000
        },
        "expectedStatus": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "assertions": {
          "type": "array",
          "items": {
            "$ref": "https://beetle.test/contracts/engines/k6/v1/assertions"
          },
          "minItems": 0,
          "maxItems": 64
        }
      }
    }
  }
}
