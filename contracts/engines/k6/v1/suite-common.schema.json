{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://beetle.test/contracts/engines/k6/v1/suite-common",
  "$defs": {
    "scalar": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 4096
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sha256",
        "bytes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8388608
        }
      }
    },
    "fields": {
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 0,
        "maxLength": 4096
      }
    },
    "wait": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "durationMs",
        "jitterMs"
      ],
      "properties": {
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        },
        "jitterMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600000
        }
      }
    },
    "secret": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "provider",
        "locator"
      ],
      "properties": {
        "name": {
          "$ref": "https://beetle.test/contracts/engines/k6/v1/common#/$defs/identifier"
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    }
  }
}
