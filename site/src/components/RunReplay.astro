---
// Replay of sample runs, step by step: the public run state, the agent's attempt
// state, its admission evidence and, where one applies, the first stop cause.
// States, transitions, stop causes and final outcomes follow
// docs/system/contracts/run-lifecycle.md and outputs-settlement.md (finalisation table).
// Without JavaScript every sample is shown as a list.

type Step = { run: string; attempt?: string; admission?: string; title: string; body: string; cause?: string };
type Sample = { id: string; name: string; result: string; steps: Step[] };

const RUN_STATES = ['queued', 'dispatching', 'active', 'finalizing', 'finished', 'cancelled', 'errored'];

const queued: Step = {
  run: 'queued',
  title: 'Queued',
  body: 'The backend stores the run, its single attempt and the offer in one transaction, then answers 202. The outcome and validation status are pending.',
};
const dispatching: Step = {
  run: 'dispatching',
  attempt: 'offered',
  title: 'Offered',
  body: 'The backend claims the offer for delivery and sends it to the agent. From here on it may have arrived, so cancelling can no longer end the run at once.',
};
const admitted: Step = {
  run: 'active',
  attempt: 'admitted',
  admission: 'charged',
  title: 'Admitted',
  body: 'The agent reserves the whole budget. The backend merges the agent’s snapshot, and the run becomes active.',
};
const preparing: Step = {
  run: 'active',
  attempt: 'preparing',
  admission: 'charged',
  title: 'Preparing',
  body: 'In a fresh engine container the configuration is validated against the installed schema and compiled for k6.',
};
const running: Step = {
  run: 'active',
  attempt: 'running',
  admission: 'charged',
  title: 'Running',
  body: 'k6 sends load to your service inside the run’s budget.',
};
const exited = (body: string): Step => ({
  run: 'finalizing',
  attempt: 'exited',
  admission: 'released (settled)',
  title: 'Exited',
  body,
});
const stopped = (cause: string, body: string): Step => ({
  run: 'active',
  attempt: 'stopping',
  admission: 'charged',
  cause,
  title: 'Stopping',
  body,
});

const samples: Sample[] = [
  {
    id: 'passed',
    name: 'Passes',
    result: 'finished · passed',
    steps: [
      queued,
      dispatching,
      admitted,
      preparing,
      running,
      {
        run: 'active',
        attempt: 'collecting',
        admission: 'charged',
        title: 'Collecting',
        body: 'Results, metrics and diagnostics are written and sealed with their sizes and SHA-256 digests.',
      },
      exited('The engine exited. The reservation is released once the launch is settled, the container has stopped and collection has finished. The backend verifies the sealed output.'),
      {
        run: 'finished',
        title: 'Finished',
        body: 'Exit code 0, no out-of-memory flag, no failure reason and a completed result: the outcome comes from the sealed result, here passed. Validation status becomes passed. The run never reopens.',
      },
    ],
  },
  {
    id: 'timeout',
    name: 'Times out',
    result: 'errored · inconclusive · timeout',
    steps: [
      queued,
      dispatching,
      admitted,
      preparing,
      running,
      stopped('timeout', 'The time limit is reached. The agent records timeout as the first stop cause and asks k6 to stop gracefully.'),
      exited('The engine exited after the stop. The backend verifies what was collected.'),
      {
        run: 'errored',
        title: 'Errored',
        body: 'A timeout with a known exit ends the run errored, outcome inconclusive, reason timeout, whatever the metrics say.',
      },
    ],
  },
  {
    id: 'output',
    name: 'Hits the output limit',
    result: 'errored · inconclusive · output_limit',
    steps: [
      queued,
      dispatching,
      admitted,
      preparing,
      running,
      stopped('output_limit', 'The run writes more output than its budget. The agent records output_limit as the first stop cause and kills the engine immediately.'),
      exited('The engine exited after the kill.'),
      {
        run: 'errored',
        title: 'Errored',
        body: 'The run ends errored, outcome inconclusive, reason output_limit.',
      },
    ],
  },
  {
    id: 'cancel-running',
    name: 'Cancelled while running',
    result: 'cancelled · inconclusive',
    steps: [
      queued,
      dispatching,
      admitted,
      preparing,
      { ...running, title: 'Cancel requested', body: 'You press Cancel. The backend records cancellationRequested and answers 202. The run is still active: a request is not a stop.' },
      stopped('cancelled', 'The agent records cancelled as the first stop cause and asks k6 to stop gracefully.'),
      exited('The engine exited. Its output is accounted for like any other run’s.'),
      {
        run: 'cancelled',
        title: 'Cancelled',
        body: 'With your cancellation persisted and no system cause, the run ends cancelled, outcome inconclusive. A cancelled run is never shown as passed.',
      },
    ],
  },
  {
    id: 'cancel-queued',
    name: 'Cancelled before it was sent',
    result: 'cancelled · inconclusive · cancelled',
    steps: [
      queued,
      {
        run: 'cancelled',
        title: 'Cancelled',
        body: 'You cancel while the offer has never been claimed for delivery. The backend deletes the pending delivery and ends the run at once: cancelled, outcome inconclusive, reason cancelled. Nothing ran.',
      },
    ],
  },
];
---

<figure class="bl-replay not-content" aria-label="Replay of sample runs">
  <div class="bl-replay-pick" role="group" aria-label="Sample run" hidden>
    {samples.map((sample) => <button type="button" data-sample={sample.id}>{sample.name}</button>)}
  </div>
  <ol class="bl-replay-states" aria-hidden="true">
    {RUN_STATES.map((state) => <li data-state={state}>{state}</li>)}
  </ol>
  {
    samples.map((sample) => (
      <section class="bl-replay-sample" data-id={sample.id}>
        <h3 class="bl-replay-name">
          {sample.name} <span>{sample.result}</span>
        </h3>
        <ol class="bl-replay-steps">
          {sample.steps.map((step) => (
            <li class="bl-replay-step" data-run={step.run}>
              <p class="bl-replay-head">
                <span class="bl-replay-title">{step.title}</span>
                <span class="bl-chip">{step.run}</span>
              </p>
              <dl class="bl-replay-facts">
                {step.attempt && (<><dt>Attempt</dt><dd><code>{step.attempt}</code></dd></>)}
                {step.admission && (<><dt>Admission</dt><dd><code>{step.admission}</code></dd></>)}
                {step.cause && (<><dt>First stop cause</dt><dd><code>{step.cause}</code></dd></>)}
              </dl>
              <p class="bl-replay-body">{step.body}</p>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
  <div class="bl-replay-nav" hidden>
    <button type="button" data-go="-1" aria-label="Previous step">←</button>
    <span class="bl-replay-count" data-count aria-live="polite"></span>
    <button type="button" data-go="1" aria-label="Next step">→</button>
  </div>
</figure>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('.bl-replay')) {
    const samples = [...root.querySelectorAll<HTMLElement>('.bl-replay-sample')];
    const picks = [...root.querySelectorAll<HTMLButtonElement>('[data-sample]')];
    const states = [...root.querySelectorAll<HTMLElement>('[data-state]')];
    const [prev, next] = [...root.querySelectorAll<HTMLButtonElement>('[data-go]')];
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    let sample = samples[0];
    let current = 0;

    const steps = () => [...sample.querySelectorAll<HTMLElement>('.bl-replay-step')];
    const show = (index: number) => {
      const list = steps();
      current = Math.max(0, Math.min(list.length - 1, index));
      list.forEach((step, i) => (step.hidden = i !== current));
      const seen = new Set(list.slice(0, current + 1).map(step => step.dataset.run));
      const now = list[current].dataset.run;
      states.forEach(state => {
        state.classList.toggle('seen', seen.has(state.dataset.state));
        state.classList.toggle('now', state.dataset.state === now);
      });
      prev.disabled = current === 0;
      next.disabled = current === list.length - 1;
      count.textContent = `Step ${current + 1} of ${list.length}`;
    };
    const pick = (id: string) => {
      sample = samples.find(item => item.dataset.id === id) ?? samples[0];
      samples.forEach(item => (item.hidden = item !== sample));
      picks.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.sample === sample.dataset.id)));
      show(0);
    };

    root.classList.add('is-enhanced');
    root.querySelectorAll<HTMLElement>('[hidden]').forEach(node => {
      if (node.matches('.bl-replay-pick, .bl-replay-nav')) node.hidden = false;
    });
    picks.forEach(button => button.addEventListener('click', () => pick(button.dataset.sample!)));
    prev.addEventListener('click', () => show(current - 1));
    next.addEventListener('click', () => show(current + 1));
    root.addEventListener('keydown', event => {
      if (!(event.target instanceof HTMLElement) || event.target.closest('.bl-replay-pick')) return;
      if (event.key === 'ArrowRight') show(current + 1);
      else if (event.key === 'ArrowLeft') show(current - 1);
    });
    pick(samples[0].dataset.id!);
  }
</script>

<style>
  .bl-replay { margin-block: 1.5rem; padding: 1.25rem 1.5rem; background: var(--bl-surface); border-radius: var(--bl-radius); }
  .bl-replay-pick { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.25rem; }
  .bl-replay-pick[hidden], .bl-replay-nav[hidden] { display: none; }
  .bl-replay button {
    font: inherit;
    font-size: 0.875rem;
    padding: 0.375rem 0.75rem;
    border-radius: var(--bl-radius-sm);
    border: 1px solid var(--bl-raised);
    background: transparent;
    color: var(--sl-color-white);
    cursor: pointer;
  }
  .bl-replay button:hover:not(:disabled) { border-color: var(--sl-color-gray-4); }
  .bl-replay button[aria-pressed='true'] { background: var(--sl-color-accent); border-color: var(--sl-color-accent); color: var(--bl-accent-ink); }
  .bl-replay button:disabled { opacity: 0.35; cursor: default; }
  .bl-replay button:focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: 2px; }
  .bl-replay-states { display: none; list-style: none; padding: 0; margin: 0 0 1.25rem; gap: 0.375rem; grid-template-columns: repeat(7, 1fr); }
  .is-enhanced .bl-replay-states { display: grid; }
  .bl-replay-states li {
    margin: 0;
    padding: 0.5rem 0.125rem;
    text-align: center;
    font: 0.75rem var(--sl-font-mono);
    color: var(--sl-color-gray-3);
    background: var(--bl-zebra);
    border: 1px solid var(--bl-raised);
    border-radius: var(--bl-radius-sm);
    transition: color 0.25s, background-color 0.25s, border-color 0.25s;
  }
  .bl-replay-states li.seen { color: var(--sl-color-gray-1); }
  .bl-replay-states li.now { color: var(--sl-color-white); background: var(--sl-color-accent-low); border-color: var(--sl-color-accent); }
  .bl-replay-sample + .bl-replay-sample { margin-top: 1.5rem; }
  .is-enhanced .bl-replay-sample + .bl-replay-sample { margin-top: 0; }
  .bl-replay-name { margin: 0 0 0.75rem; font-size: 1rem; font-weight: 500; color: var(--sl-color-white); }
  .bl-replay-name span { margin-inline-start: 0.5rem; font: 0.8125rem var(--sl-font-mono); color: var(--sl-color-gray-2); }
  .is-enhanced .bl-replay-name { display: none; }
  .bl-replay-steps { list-style: none; padding: 0; margin: 0; }
  .bl-replay-step { margin: 0; }
  .bl-replay-step + .bl-replay-step { margin-top: 1rem; }
  .is-enhanced .bl-replay-step + .bl-replay-step { margin-top: 0; }
  .is-enhanced .bl-replay-step { min-height: 9rem; }
  .bl-replay-head { display: flex; align-items: center; gap: 0.625rem; margin: 0; }
  .bl-replay-title { font-size: 1.0625rem; font-weight: 500; color: var(--sl-color-white); }
  .bl-replay-head .bl-chip { margin-inline-start: auto; }
  .bl-replay-facts { display: flex; flex-wrap: wrap; gap: 0.25rem 0.5rem; margin: 0.5rem 0 0; font-size: 0.8125rem; }
  .bl-replay-facts dt { color: var(--sl-color-gray-2); }
  .bl-replay-facts dd { margin: 0 0.75rem 0 0; }
  .bl-replay-body { margin: 0.5rem 0 0; color: var(--sl-color-text); }
  .bl-replay-nav { display: flex; align-items: center; gap: 0.75rem; margin-top: 1rem; }
  .bl-replay-count { flex: 1; text-align: center; font-size: 0.8125rem; color: var(--sl-color-gray-2); }
  @media (max-width: 40rem) {
    .bl-replay { padding: 1rem; }
    .bl-replay-states { grid-template-columns: repeat(4, 1fr); }
  }
  @media (prefers-reduced-motion: reduce) {
    .bl-replay-states li { transition: none; }
  }
</style>
