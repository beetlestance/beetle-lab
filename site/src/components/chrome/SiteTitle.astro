---
// Logo, product name and the "Docs" tag. The logo is inline so it takes the skin's colours.
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title bl-brand">
  <svg viewBox="0 0 22 22" width="22" height="22" aria-hidden="true">
    <path d="M3 14a8 8 0 0 1 16 0Z" fill="var(--amber)"></path>
    <path d="M11 6.2V14" stroke="var(--bg)" stroke-width="1.4"></path>
    <circle cx="7.6" cy="11" r="1.3" fill="var(--bg)"></circle>
    <circle cx="14.4" cy="11" r="1.3" fill="var(--bg)"></circle>
    <rect x="2" y="15.2" width="18" height="2.2" rx="1.1" fill="var(--ink)"></rect>
  </svg>
  <span class="bl-brand-name" translate="no">{siteTitle}</span>
  <span class="bl-tag">Docs</span>
</a>
