---
// The parts of an installation, lit in request order (styles in custom.css). Without
// motion it shows the board's frame: the request has reached the agent.
const parts = [
  { name: 'Browser', sub: 'you', edge: true },
  { name: 'Frontend', sub: 'UI + /api proxy' },
  { name: 'Backend', sub: 'API + results' },
  { name: 'Agent', sub: 'admission', current: true },
  { name: 'k6 engine', sub: 'one per run' },
  { name: 'Your service', sub: 'under test', edge: true },
];
const reached = parts.findIndex((part) => part.current);
---

<figure class="bl-flow not-content">
  <ol
    aria-label="A request flows from the browser through the frontend, backend and agent to a k6 engine, which sends load to your service."
  >
    {
      parts.map((part, i) => (
        <>
          {i > 0 && <li class:list={['link', { lit: i <= reached }]} aria-hidden="true" />}
          <li class:list={['node', { edge: part.edge, current: part.current }]} style={`--step:${i}`}>
            <span class="name">{part.name}</span>
            <span class="sub">{part.sub}</span>
          </li>
        </>
      ))
    }
  </ol>
  <figcaption>Only the frontend publishes a port. The engine is the only part that talks to your service.</figcaption>
</figure>
