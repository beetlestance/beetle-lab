---
// Page title with the section breadcrumb above it and the page description as a
// lede below it, as in the Penpot "Docs" boards.
import Default from '@astrojs/starlight/components/PageTitle.astro';

const { entry, sidebar } = Astro.locals.starlightRoute;

/** Label of the sidebar group that holds the current page, if any. */
function findGroup(entries, parent) {
  for (const item of entries) {
    if (item.type === 'link' && item.isCurrent) return parent;
    if (item.type === 'group') {
      const found = findGroup(item.entries, item.label);
      if (found) return found;
    }
  }
  return undefined;
}

const section = findGroup(sidebar, undefined);
const lede = entry.data.description;
---

{section && <p class="bl-crumb">{section}</p>}
<Default />
{lede && <p class="bl-lede">{lede}</p>}

<style>
  .bl-crumb {
    margin: 1rem 0 -0.5rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--sl-color-gray-2);
  }
  .bl-lede {
    margin-top: 0.75rem;
    max-width: 38rem;
    font-size: 1.1875rem;
    line-height: 1.5;
    color: var(--sl-color-gray-2);
  }
</style>
