---
// Step-by-step walkthrough of one run. Without JavaScript every step is shown as a
// list; with it, one step at a time with the parts involved lit above.
const parts = ['Browser', 'Backend', 'Agent', 'k6 engine', 'Your service'];

const steps = [
  {
    title: 'Queue',
    parts: [0, 1],
    state: 'queued',
    body: 'The backend records the run and its request ID before anything else. Sending the same request again returns the same run instead of starting another.',
    fails: 'Nothing has left the backend yet. Cancelling now ends the run at once; nothing ran.',
  },
  {
    title: 'Offer',
    parts: [1, 2],
    state: 'dispatching',
    body: 'The backend offers the run to the agent with the exact revision, engine and budget. Nothing in the offer comes from the browser unchecked.',
    fails: 'If the reply to an offer is lost, the backend asks the agent what it has before offering again, so a run is never started twice.',
  },
  {
    title: 'Admit',
    parts: [2],
    state: 'active',
    body: 'The agent checks the whole budget against free capacity and the run’s execution policy, then reserves it.',
    fails: 'If the budget does not fit now, the agent says why and the run waits. The run page shows the reason.',
  },
  {
    title: 'Validate and prepare',
    parts: [2, 3],
    state: 'active',
    body: 'In a fresh engine container, the configuration is validated against the installed schema and compiled into a k6 script.',
    fails: 'A configuration the engine rejects ends the run as errored with the reason invalid_config.',
  },
  {
    title: 'Execute',
    parts: [3, 4],
    state: 'active',
    body: 'k6 sends load to your service inside its CPU, memory, process, time and output limits. Live metrics appear on the run page about every 2 s.',
    fails: 'A timeout or output limit stops the engine; the first cause is kept. On cancel the engine gets 5 s to stop before it is forced.',
  },
  {
    title: 'Collect and seal',
    parts: [3],
    state: 'active',
    body: 'Results, metrics, warnings and diagnostics are written, then sealed with their sizes and SHA-256 digests.',
    fails: 'If the engine crashes or its result is invalid, the run errors. An exit code of 0 alone never makes a run pass.',
  },
  {
    title: 'Transfer and finalise',
    parts: [2, 1],
    state: 'finalizing',
    body: 'The agent hands the sealed output to the backend, which checks every size and digest and only then records the outcome. The run turns finished.',
    fails: 'If the transfer fails, it is retried from the sealed copy. The test itself is never run again.',
  },
];
---

<figure class="bl-walk not-content" aria-label="Walkthrough of one run">
  <ol class="bl-walk-parts" aria-hidden="true">
    {parts.map((name, i) => <li data-part={i}>{name}</li>)}
  </ol>
  <ol class="bl-walk-steps">
    {
      steps.map((step, i) => (
        <li class="bl-walk-step" data-parts={step.parts.join(' ')} id={`run-step-${i + 1}`}>
          <p class="bl-walk-head">
            <span class="bl-walk-num">{i + 1}</span>
            <span class="bl-walk-title">{step.title}</span>
            <span class="bl-walk-state">{step.state}</span>
          </p>
          <p class="bl-walk-body">{step.body}</p>
          <p class="bl-walk-fails"><strong>If it goes wrong:</strong> {step.fails}</p>
        </li>
      ))
    }
  </ol>
  <div class="bl-walk-nav" hidden>
    <button type="button" data-go="-1" aria-label="Previous step">←</button>
    <span class="bl-walk-dots" role="tablist" aria-label="Steps">
      {steps.map((step, i) => (
        <button type="button" role="tab" data-to={i} aria-label={`Step ${i + 1}: ${step.title}`} />
      ))}
    </span>
    <button type="button" data-go="1" aria-label="Next step">→</button>
  </div>
</figure>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('.bl-walk')) {
    const steps = [...root.querySelectorAll<HTMLElement>('.bl-walk-step')];
    const parts = [...root.querySelectorAll<HTMLElement>('[data-part]')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-to]')];
    const nav = root.querySelector<HTMLElement>('.bl-walk-nav')!;
    const [prev, next] = [...root.querySelectorAll<HTMLButtonElement>('[data-go]')];
    let current = 0;

    const show = (index: number, focus = false) => {
      current = Math.max(0, Math.min(steps.length - 1, index));
      const lit = new Set(steps[current].dataset.parts!.split(' '));
      steps.forEach((step, i) => (step.hidden = i !== current));
      parts.forEach(part => part.classList.toggle('lit', lit.has(part.dataset.part!)));
      dots.forEach((dot, i) => {
        dot.setAttribute('aria-selected', String(i === current));
        dot.tabIndex = i === current ? 0 : -1;
      });
      prev.disabled = current === 0;
      next.disabled = current === steps.length - 1;
      if (focus) dots[current].focus();
    };

    root.classList.add('is-enhanced');
    nav.hidden = false;
    prev.addEventListener('click', () => show(current - 1));
    next.addEventListener('click', () => show(current + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => show(i)));
    root.addEventListener('keydown', event => {
      if (event.key === 'ArrowRight') show(current + 1, true);
      else if (event.key === 'ArrowLeft') show(current - 1, true);
    });
    show(0);
  }
</script>

<style>
  .bl-walk {
    margin-block: 1.5rem;
    padding: 1.25rem 1.5rem;
    background: var(--bl-surface);
    border-radius: var(--bl-radius);
  }
  .bl-walk-parts {
    display: none;
    list-style: none;
    padding: 0;
    margin: 0 0 1.25rem;
    gap: 0.5rem;
    grid-template-columns: repeat(5, 1fr);
  }
  .is-enhanced .bl-walk-parts { display: grid; }
  .bl-walk-parts li {
    margin: 0;
    padding: 0.625rem 0.25rem;
    text-align: center;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--sl-color-gray-3);
    background: var(--bl-zebra);
    border: 1px solid var(--bl-raised);
    border-radius: var(--bl-radius-sm);
    transition: color 0.25s, background-color 0.25s, border-color 0.25s;
  }
  .bl-walk-parts li.lit {
    color: var(--sl-color-white);
    background: var(--sl-color-accent-low);
    border-color: var(--sl-color-accent);
  }
  .bl-walk-steps { list-style: none; padding: 0; margin: 0; }
  .bl-walk-step { margin: 0; }
  .bl-walk-step + .bl-walk-step { margin-top: 1.25rem; }
  .is-enhanced .bl-walk-step + .bl-walk-step { margin-top: 0; }
  .is-enhanced .bl-walk-step { min-height: 9.5rem; }
  .bl-walk-head { display: flex; align-items: center; gap: 0.625rem; margin: 0; }
  .bl-walk-num {
    display: inline-grid;
    place-items: center;
    inline-size: 1.5rem;
    block-size: 1.5rem;
    border-radius: 50%;
    background: var(--sl-color-accent);
    color: var(--bl-accent-ink);
    font-size: 0.8125rem;
    font-weight: 600;
  }
  .bl-walk-title { font-size: 1.0625rem; font-weight: 500; color: var(--sl-color-white); }
  .bl-walk-state {
    margin-inline-start: auto;
    padding: 0.125rem 0.5rem;
    border-radius: 999px;
    background: var(--bl-raised);
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
    color: var(--bl-code);
  }
  .bl-walk-body { margin: 0.625rem 0 0; color: var(--sl-color-text); }
  .bl-walk-fails { margin: 0.5rem 0 0; font-size: 0.9375rem; color: var(--sl-color-gray-2); }
  .bl-walk-fails strong { color: var(--sl-color-gray-1); font-weight: 500; }
  .bl-walk-nav { display: flex; align-items: center; gap: 0.75rem; margin-top: 1rem; }
  .bl-walk-nav[hidden] { display: none; }
  .bl-walk-nav > button {
    inline-size: 2.25rem;
    block-size: 2.25rem;
    border-radius: var(--bl-radius-sm);
    border: 1px solid var(--bl-raised);
    background: transparent;
    color: var(--sl-color-white);
    cursor: pointer;
  }
  .bl-walk-nav > button:hover:not(:disabled) { border-color: var(--sl-color-gray-4); }
  .bl-walk-nav > button:disabled { opacity: 0.35; cursor: default; }
  .bl-walk-dots { display: flex; gap: 0.375rem; flex: 1; justify-content: center; }
  .bl-walk-dots button {
    inline-size: 1.75rem;
    block-size: 0.375rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: var(--bl-track);
    cursor: pointer;
  }
  .bl-walk-dots button[aria-selected='true'] { background: var(--sl-color-accent); }
  .bl-walk button:focus-visible { outline: 2px solid var(--sl-color-accent); outline-offset: 2px; }
  @media (max-width: 40rem) {
    .bl-walk { padding: 1rem; }
    .bl-walk-parts { grid-template-columns: repeat(3, 1fr); }
    .bl-walk-dots button { inline-size: 1.125rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .bl-walk-parts li { transition: none; }
  }
</style>
