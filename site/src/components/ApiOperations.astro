---
// Every JSON operation of the public API, read at build time from the contract
// file that also generates the server routes and the client, so this list cannot
// drift from the API.
import operations from '../../../contracts/api/v2/http-operations.json';

type Operation = { name: string; method: string; path: string; successStatus: number; implementation: string };

const groupOf = (path: string) => {
  const parts = path.replace('/api/v2/', '').split('/').filter(part => !part.startsWith('{'));
  const last = parts.at(-1) ?? '';
  if (parts[0] === 'auth') return 'Sessions';
  if (/settings|retention/.test(path)) return 'Settings and retention';
  if (parts.includes('runs') || last === 'comparisons') return 'Runs and results';
  if (parts.includes('exports')) return 'Exports';
  if (parts.includes('inputs')) return 'Inputs';
  if (parts.includes('suites') || parts.includes('revisions')) return 'Suites and revisions';
  if (parts.includes('workspaces') || parts.includes('folders') || last === 'overview') return 'Workspaces and folders';
  return 'Organisations';
};

const order = ['Sessions', 'Organisations', 'Workspaces and folders', 'Suites and revisions', 'Inputs',
  'Runs and results', 'Exports', 'Settings and retention'];
const groups = new Map<string, Operation[]>(order.map(name => [name, []]));
for (const operation of operations as Operation[]) {
  if (operation.implementation !== 'implemented') continue;
  groups.get(groupOf(operation.path))!.push(operation);
}
const short = (path: string) => path
  .replace('/api/v2', '')
  .replace('/organizations/{organizationId}/workspaces/{workspaceId}', '/…/{workspaceId}')
  .replace('/organizations/{organizationId}', '/…/{organizationId}');
const words = (name: string) => name.replace(/([a-z])([A-Z])/g, '$1 $2').toLowerCase();
---

{
  [...groups].filter(([, list]) => list.length).map(([name, list]) => (
    <>
      <h3>{name}</h3>
      <table class="bl-api">
        <thead><tr><th>Method</th><th>Path</th><th>Does</th></tr></thead>
        <tbody>
          {list.map(op => (
            <tr>
              <td><span class={`bl-method ${op.method.toLowerCase()}`}>{op.method}</span></td>
              <td><code title={op.path}>{short(op.path)}</code></td>
              <td>{words(op.name)}{op.successStatus === 202 && ' (accepted, 202)'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </>
  ))
}

<style>
  .bl-api td:nth-child(2) code { white-space: normal; overflow-wrap: anywhere; }
  .bl-method { font-family: var(--sl-font-mono); font-size: 0.75rem; font-weight: 600; color: var(--sl-color-gray-2); }
  .bl-method.get { color: var(--bl-info); }
  .bl-method.post { color: var(--bl-pass); }
  .bl-method.patch { color: var(--sl-color-accent); }
  .bl-method.delete { color: var(--bl-fail); }
</style>
