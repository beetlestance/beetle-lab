# Don't ship developer artifacts or per-machine state into the image.
.git
.gitignore
.gitattributes
node_modules
runs
configs/*
!configs/.gitkeep
.DS_Store
.env*
*.log
.idea
.vscode
.vscode-test
Dockerfile
.dockerignore
docker-compose.yml
docker-compose.*.yml
*.tgz
# Local rewrite orchestration, generated outputs and isolated agent state.
.agent-work
.beetle
**/.beetle
.agent-output
**/.agent-work
**/.agent-output
**/dist
coverage
*.tsbuildinfo

# Local credential/agent state must never enter a remote build context.
.aws
.ssh
.codex
.agents
**/.aws
**/.ssh
**/.codex
**/.agents
**/node_modules
