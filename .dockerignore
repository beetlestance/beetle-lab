# Don't ship developer artifacts or per-machine state into the image.
.git
.gitignore
.gitattributes
node_modules
runs
configs/*
!configs/.gitkeep
.DS_Store
.env*
*.log
.idea
.vscode
.vscode-test
Dockerfile
.dockerignore
docker-compose.yml
docker-compose.*.yml
*.tgz
# Local rewrite orchestration, generated outputs and isolated agent state.
.agent-work
.agent-output
**/.agent-work
**/.agent-output
**/dist
coverage
*.tsbuildinfo
