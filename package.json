{
  "name": "beetle-lab",
  "version": "1.1.0",
  "description": "Local web UI for k6-based HTTP load testing. Upload a config JSON, run, watch live charts and logs.",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "check": "node scripts/check.mjs",
    "test": "npm run test:legacy && npm run test:v2",
    "test:legacy": "node --test test/api.test.js",
    "test:v2": "vitest run",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "lint": "node --import tsx tools/lint.ts",
    "check:architecture": "node --import tsx tools/check-architecture.ts",
    "check:docs": "node --import tsx tools/check-docs.ts",
    "verify:v2": "npm run check:contracts && npm run check:api && npm run check:k6 && npm run typecheck && npm run lint && npm run check:architecture && npm run check:docs && npm run test:v2",
    "generate:contracts": "node --import tsx contracts/scripts/generate.ts",
    "check:contracts": "node --import tsx contracts/scripts/generate.ts --check",
    "generate:api": "node --import tsx contracts/scripts/generate-api.ts",
    "check:api": "node --import tsx contracts/scripts/generate-api.ts --check",
    "generate:k6": "node --import tsx engines/k6/compiler/generate.ts",
    "check:k6": "node --import tsx engines/k6/compiler/generate.ts --check"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "express": "4.22.3",
    "ws": "8.21.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/beetlestance/beetle-lab.git"
  },
  "workspaces": [
    "app",
    "agent",
    "contracts",
    "web",
    "engines/k6"
  ],
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "jsdom": "31.0.0",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "overrides": {
    "eslint@10.14.0": {
      "minimatch": "11.0.1"
    },
    "@eslint/config-array@0.23.5": {
      "minimatch": "11.0.1"
    },
    "@typescript-eslint/typescript-estree@8.72.1": {
      "minimatch": "11.0.1"
    }
  }
}
