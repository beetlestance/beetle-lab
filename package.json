{
  "name": "beetle-lab",
  "version": "1.1.0",
  "description": "Local container-based testing workbench with isolated k6 engines.",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "docker compose up --build -d",
    "dev": "docker compose up --build",
    "dev:web": "vite --config web/vite.config.ts --host 127.0.0.1",
    "build:web": "vite build --config web/vite.config.ts",
    "check": "npm run typecheck && npm run format:check && npm run lint && npm run check:architecture && npm run check:docs && npm run check:site-docs",
    "test": "npm run test:v2",
    "test:v2": "vitest run",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p web/tsconfig.json --noEmit && tsc -p engines/k6/tsconfig.runtime.json --noEmit",
    "lint": "node --import tsx tools/lint.ts",
    "check:architecture": "node --import tsx tools/check-architecture.ts",
    "check:docs": "node --import tsx tools/check-docs.ts",
    "check:site-docs": "node --import tsx tools/check-site-docs.ts",
    "check:a11y": "node tools/qualification/browser/a11y.mjs",
    "docs:stamp": "node --import tsx tools/stamp-docs.ts",
    "verify:v2": "npm run check:contracts && npm run check:api && npm run check:k6 && npm run typecheck && npm run format:check && npm run lint && npm run check:architecture && npm run check:docs && npm run check:site-docs && npm run build:web && npm run test:v2",
    "generate:contracts": "node --import tsx contracts/scripts/generate.ts",
    "check:contracts": "node --import tsx contracts/scripts/generate.ts --check",
    "generate:api": "node --import tsx contracts/scripts/generate-api.ts",
    "check:api": "node --import tsx contracts/scripts/generate-api.ts --check",
    "generate:k6": "node --import tsx engines/k6/compiler/generate.ts",
    "check:k6": "node --import tsx engines/k6/compiler/generate.ts --check",
    "build:api": "node --import tsx tools/build-api.ts",
    "build:agent": "node --import tsx tools/build-agent.ts",
    "start:agent": "node agent/dist/main.js",
    "smoke:agent": "node --import tsx agent/test/bootstrap/smoke-agent.ts",
    "start:api": "node app/dist/main.js",
    "smoke:api": "node --import tsx app/test/bootstrap/smoke-api.ts",
    "smoke:input-controls": "node --import tsx web/test/smoke-input-controls.ts",
    "build:k6": "node --import tsx tools/build-k6.ts",
    "smoke:agent:docker": "node --import tsx agent/test/container/smoke-agent.ts",
    "format": "node --import tsx tools/format.ts --write",
    "format:check": "node --import tsx tools/format.ts --check"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/beetlestance/beetle-lab.git"
  },
  "workspaces": [
    "app",
    "agent",
    "contracts",
    "web",
    "engines/k6"
  ],
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "6.0.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "jsdom": "31.0.0",
    "prettier": "3.10.1",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  },
  "overrides": {
    "eslint@10.14.0": {
      "minimatch": "11.0.1"
    },
    "@eslint/config-array@0.23.5": {
      "minimatch": "11.0.1"
    },
    "@typescript-eslint/typescript-estree@8.72.1": {
      "minimatch": "11.0.1"
    }
  }
}
