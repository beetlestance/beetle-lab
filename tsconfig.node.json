{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "node"
    ],
    "lib": [
      "ES2023"
    ]
  },
  "include": [
    "app/**/*.ts",
    "agent/**/*.ts",
    "contracts/**/*.ts",
    "engines/k6/**/*.ts",
    "tools/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/dist/**",
    "engines/k6/runtime/**"
  ]
}
